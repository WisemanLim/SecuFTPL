# SecuFTPL — 환경 변수 예시 (커밋용, placeholder만)
# 실 비밀번호/토큰 절대 커밋 금지 — Vault/Secret Manager 주입.
# 환경별 파일: .env.local / .env.dev / .env.staging / .env.prod (gitignore 대상)

# --- Service (profile: python-fastapi) ---
APP_ENV=local                        # local | dev | staging | prod
BIND_HOST=127.0.0.1                  # 포트 바인드 IP. LAN/외부 노출 시 0.0.0.0
API_PORT=8000                        # FastAPI 노출 포트
DATABASE_URL=sqlite:///./local.db    # local=sqlite, dev+=postgresql://user:pass@host:5432/db
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=app
REDIS_PORT=6379

# --- HuggingFace (F2: 모델 다운로드·이벤트) ---
HF_TOKEN=<YOUR_HF_TOKEN>             # gated 모델(Llama 등) 다운로드 시 필수
HF_EVENT_MODE=polling                # polling(기본) | webhook — N2SF 망분리 환경은 polling 고정
HF_POLLING_CRON=0 3 * * 1            # polling 주기: 주 1회 (기본, 월 03:00)
HF_WEBHOOK_SECRET=                   # webhook 모드 시 필수
HF_SIMILARITY_CRITERIA=family,param_size,license  # 유사 모델 판정 기준

# --- Fine-tune batch trigger (F5) ---
FT_TRIGGER_MODE=schedule             # schedule(기본) | record_count | token_count
FT_TRIGGER_SCHEDULE_CRON=0 2 * * *   # schedule 모드: 야간 배치 시각
FT_TRIGGER_RECORD_THRESHOLD=500      # record_count 모드 임계값
FT_TRIGGER_TOKEN_THRESHOLD=1000000   # token_count 모드 임계값

# --- Satisfaction schema (F4) ---
SATISFACTION_SCALE=binary            # binary(기본, up/down) | likert5(1~5)

# --- Model serving ---
SERVING_STACK=ollama                 # ollama(기본) | vllm | tgi
OLLAMA_BASE_URL=http://localhost:11434

# --- Tuning start gate + resource limits (F9, PRD §7.5·§7.12) ---
DATASET_MIN_RECORDS=500              # approved 레코드 이 값 미만이면 튜닝 잡 제출 차단
JOB_MAX_GPU=1                        # 잡당 GPU 개수 기본 상한 (제출 시 개별 오버라이드 가능)
JOB_MAX_VRAM_GB=24                   # 잡당 VRAM 기본 상한(GB)
TOTAL_GPU_CAPACITY=2                 # 시스템 전체 동시 학습 GPU 상한 — 초과 잡은 큐잉(F9 실제 큐잉)

# --- Frontend (E7) ---
FRONT_PORT=3000
